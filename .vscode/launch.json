{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CredStor API Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/api/server.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "CREDSTOR_ENV": "development"
            },
            "args": []
        },
        {
            "name": "CredStor CLI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/cli/credstor.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": ["--help"]
        },
        {
            "name": "Run Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "tests/",
                "-v",
                "--tb=short"
            ]
        },
        {
            "name": "Debug Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}